# ==============================================================================
# Last Breath // Git Ignore Rules
# Designed for Zero-Dependency Vanilla JS, Node Build Tooling, and GitHub Pages
# ==============================================================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# IDE & Editor Configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Node.js & Package Managers (if added in the future)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/

# Python Artifacts (internal generation scripts)
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# Local Environment Variables & Secrets
.env
.env.*
!.env.example

# Logs, Diagnostics & Temp Files
*.log
*.tmp
*.bak
scratch/

# Build Output Architecture Notice:
# dist/app.bundle.js is deliberately TRACKED and NOT ignored.
# Keeping dist/ in git enables instant zero-build GitHub Pages deployment
# and allows standalone offline execution directly via browser file:// protocols.

